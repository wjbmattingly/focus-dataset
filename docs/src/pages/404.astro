---
import SiteLayout from "../components/SiteLayout.astro";
import { url } from "../lib/url";
---

<SiteLayout title="Page not found">
  <div class="page wrap--reading">
    <header class="page__header">
      <p class="page__eyebrow">404</p>
      <h1 class="page__title">Page not found</h1>
      <p class="page__lede">That page doesn't exist (yet). Try the <a href={url("/")}>home page</a>
        or <a href={url("/search")}>search</a>.</p>
    </header>
  </div>
</SiteLayout>
